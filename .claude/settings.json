{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-start.sh",
            "timeout": 600
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(bin/vedit:*)",
      "Bash(scripts/setup.sh:*)",
      "Bash(ffmpeg:*)",
      "Bash(ffprobe:*)"
    ]
  }
}
